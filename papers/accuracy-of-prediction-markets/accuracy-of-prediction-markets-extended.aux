\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Brier score decomposes into calibration loss (6.8\%) and sharpness gain (4.2\%), yielding net 2.6\% improvement from sharp but miscalibrated to less sharp but better-calibrated forecasts.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:brier_decomposition}{{7}{11}{Brier score decomposes into calibration loss (6.8\%) and sharpness gain (4.2\%), yielding net 2.6\% improvement from sharp but miscalibrated to less sharp but better-calibrated forecasts}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Crypto markets show highest volatility (22.1\% std. dev.); politics most stable (14.7\%). Volatility likely reflects information environment: crypto price sensitive to continuous data; politics driven by discrete events.}}{12}{figure.8}\protected@file@percent }
\newlabel{fig:volatility}{{8}{12}{Crypto markets show highest volatility (22.1\% std. dev.); politics most stable (14.7\%). Volatility likely reflects information environment: crypto price sensitive to continuous data; politics driven by discrete events}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Steady improvement in market-wide calibration from Oct 2021 (0.158) to Nov 2025 (0.126), reflecting platform maturation, increased participation density, and learning effects.}}{12}{figure.9}\protected@file@percent }
\newlabel{fig:trend}{{9}{12}{Steady improvement in market-wide calibration from Oct 2021 (0.158) to Nov 2025 (0.126), reflecting platform maturation, increased participation density, and learning effects}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Power-law distribution of trade volume: most markets thin (<100 trades), few very liquid (10k+ trades). Median 245 trades; mean 987 trades across population.}}{13}{figure.10}\protected@file@percent }
\newlabel{fig:distribution}{{10}{13}{Power-law distribution of trade volume: most markets thin (<100 trades), few very liquid (10k+ trades). Median 245 trades; mean 987 trades across population}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Markets with tight spreads (<0.5\%) show 3.2\% MAE; wide spreads (20\%+) show 15.7\% MAE, consistent with bid-ask microstructure predicting information asymmetry and liquidity.}}{13}{figure.11}\protected@file@percent }
\newlabel{fig:spread}{{11}{13}{Markets with tight spreads (<0.5\%) show 3.2\% MAE; wide spreads (20\%+) show 15.7\% MAE, consistent with bid-ask microstructure predicting information asymmetry and liquidity}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces More active markets (high daily update frequency) exhibit better calibration (lower Brier). Markets with <0.5 updates/day average 0.18 Brier; 50+ updates/day average 0.10 Brier.}}{14}{figure.12}\protected@file@percent }
\newlabel{fig:updates}{{12}{14}{More active markets (high daily update frequency) exhibit better calibration (lower Brier). Markets with <0.5 updates/day average 0.18 Brier; 50+ updates/day average 0.10 Brier}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Trader diversity strongly predicts accuracy. Markets with 1 unique trader show 0.22 Brier; 500+ traders show 0.08 Brier. Wisdom of Crowds effect dominates.}}{14}{figure.13}\protected@file@percent }
\newlabel{fig:traders}{{13}{14}{Trader diversity strongly predicts accuracy. Markets with 1 unique trader show 0.22 Brier; 500+ traders show 0.08 Brier. Wisdom of Crowds effect dominates}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Most markets resolve within 7 days (65\%); long-duration markets (365+ days) are 8\% of population. Short horizons limit information accumulation but enable rapid resolution.}}{15}{figure.14}\protected@file@percent }
\newlabel{fig:resolution}{{14}{15}{Most markets resolve within 7 days (65\%); long-duration markets (365+ days) are 8\% of population. Short horizons limit information accumulation but enable rapid resolution}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Within-market convergence: early prices (1--5 trades) show 45\% MAE; by 1,000 trades, MAE drops to 6\%. Illustrates lifecycle convergence mechanism.}}{15}{figure.15}\protected@file@percent }
\newlabel{fig:lifecycle}{{15}{15}{Within-market convergence: early prices (1--5 trades) show 45\% MAE; by 1,000 trades, MAE drops to 6\%. Illustrates lifecycle convergence mechanism}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Volume effect coefficient stable across specifications (range -0.042 to -0.041), demonstrating robustness. Exclusion of any single category leaves effect intact.}}{16}{figure.16}\protected@file@percent }
\newlabel{fig:robustness}{{16}{16}{Volume effect coefficient stable across specifications (range -0.042 to -0.041), demonstrating robustness. Exclusion of any single category leaves effect intact}{figure.16}{}}
